# URL вашего InfluxDB (v2.x)
INFLUX_URL=http://192.168.1.10:8086

# API-токен InfluxDB с правами read (минимум) на нужный bucket
INFLUX_TOKEN=

# Организация и bucket в InfluxDB
INFLUX_ORG=my-org
INFLUX_BUCKET=ha_data

# Bearer-токен для авторизации запросов к этому MCP-серверу.
# Сгенерируйте случайную строку, например: python3 -c "import secrets; print(secrets.token_hex(32))"
# Если оставить пустым — сервер будет отвечать без авторизации (только для локальной сети!).
MCP_SECRET=

# Домен, на котором сервер доступен снаружи (нужен только для /.well-known/oauth-authorization-server,
# см. README — Security model)
DOMAIN=influx-mcp.example.com
