# URL of your InfluxDB (v2.x)
INFLUX_URL=http://192.168.1.10:8086

# InfluxDB API token with at least read access to the target bucket
INFLUX_TOKEN=

# Organization and bucket in InfluxDB
INFLUX_ORG=my-org
INFLUX_BUCKET=ha_data

# Bearer token used to authorize requests to this MCP server.
# Generate a random string, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
# If left empty, the server responds without checking auth (local network only!).
MCP_SECRET=

# Domain this server is reachable at externally (only needed for
# /.well-known/oauth-authorization-server, see README — Security model)
DOMAIN=influx-mcp.example.com
